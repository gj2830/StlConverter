<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Template for the package: an empty DesignSpark document (nothing in it to leak into what is saved) -->
    <EmbeddedResource Include="SpaceClaim/template.rsdocx" LogicalName="template.rsdocx" />
  </ItemGroup>

  <ItemGroup>
    <!-- mesh repair (hole filling, simplification): geometry3Sharp taken in as source -->
    <ProjectReference Include="../Geometry3Sharp/Geometry3Sharp.csproj" />
  </ItemGroup>

  <!-- (what comes from rvt-rs is under Apache 2.0: its notice and licence go along with every program built on this) -->
  <ItemGroup>
    <None Include="../../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../licenses/rvt-rs-LICENSE.txt" Link="licenses/rvt-rs-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
