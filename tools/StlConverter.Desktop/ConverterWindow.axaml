<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StlConverter.Desktop"
        x:Class="StlConverter.Desktop.ConverterWindow"
        Title="Mesh ➜ Solid" Icon="/Assets/logo.png" Width="1480" Height="900" Background="{StaticResource Page}"
        FontSize="12" DragDrop.AllowDrop="True">
  <Window.Styles>
    <StyleInclude Source="avares://StlConverter.Desktop/Theme.axaml"/>
  </Window.Styles>
  <Grid Margin="16" ColumnDefinitions="350,*">

    <!-- ============================== controls (as the WPF window: fine tuning folds away, the brush/wand sliders only
         show in their mode); the buttons stay at the bottom -->
    <Grid Margin="4,0,12,0" RowDefinitions="Auto,*,Auto">
      <StackPanel>
        <DockPanel>
          <Button x:Name="LanguageButton" DockPanel.Dock="Right" Classes="pill" Content="🌐  NL" VerticalAlignment="Center" Margin="0"
                  ToolTip.Tip="Taal / language: Nederlands · English"/>
          <Border Width="42" Height="39" CornerRadius="9" Margin="0,0,10,0" VerticalAlignment="Center" ClipToBounds="True">
            <Image Source="/Assets/logo.png" Stretch="UniformToFill"/>
          </Border>
          <TextBlock Text="Mesh ➜ Solid" FontSize="26" FontWeight="Black" Foreground="{StaticResource AccentGradient}" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock Text="Van driehoekjes naar échte vlakken, cilinders, bollen en donuts." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,4,0,10"/>
      </StackPanel>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Classes="card">
            <StackPanel>
              <TextBlock Text="📂  BESTAND" Classes="cardTitle"/>
              <Grid ColumnDefinitions="*,Auto">
                <Button x:Name="OpenButton" Content="Open STL / 3MF…" Classes="pill" HorizontalAlignment="Left" Margin="0"/>
                <ComboBox x:Name="UnitBox" Grid.Column="1" SelectedIndex="0" Width="80" VerticalAlignment="Center" ToolTip.Tip="Eenheid in het bestand">
                  <ComboBoxItem Content="mm" Tag="0.001"/>
                  <ComboBoxItem Content="inch" Tag="0.0254"/>
                  <ComboBoxItem Content="cm" Tag="0.01"/>
                  <ComboBoxItem Content="m" Tag="1"/>
                </ComboBox>
              </Grid>
              <TextBlock x:Name="FileText" Text="…of sleep een bestand op het venster." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>

          <Border Classes="card" Padding="16,10">
            <StackPanel>
              <Grid>
                <ToggleButton x:Name="CleanToggle" Classes="fold" HorizontalAlignment="Left" ToolTip.Tip="Opschonen tonen of verbergen" Content="🧹  OPSCHONEN"/>
                <TextBlock x:Name="CleanBadge" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource Muted}"/>
              </Grid>
              <StackPanel Margin="0,8,0,0" IsVisible="{Binding #CleanToggle.IsChecked}">
                <WrapPanel>
                  <ToggleButton x:Name="HoleBox" Classes="chip" IsChecked="True" Content="🕳️  gaten dichten" ToolTip.Tip="Open randen dichtmaken; een plat gat wordt plat gevuld."/>
                  <ToggleButton x:Name="ManifoldBox" Classes="chip" IsChecked="True" Content="🧩  non-manifold"
                                ToolTip.Tip="Dubbele driehoekjes en driehoekjes op een rand die al twee buren heeft weghalen (het gat dat dat geeft wordt gedicht)."/>
                  <ToggleButton x:Name="PiecesBox" Classes="chip" IsChecked="True" Content="✂️  snippers weg" ToolTip.Tip="Losse stukjes kleiner dan 1 % van het grootste stuk weghalen."/>
                </WrapPanel>
                <Grid><TextBlock Text="Vereenvoudigen tot" Classes="label"/><TextBlock x:Name="SimplifyText" Classes="value"/></Grid>
                <Slider x:Name="SimplifySlider" Minimum="1" Maximum="100" Value="100" IsSnapToTickEnabled="True" TickFrequency="1"
                        ToolTip.Tip="Minder driehoekjes (voor heel grote meshes). De hoekpunten blijven originele punten. Let op: te ver vereenvoudigen maakt rondingen moeilijker te herkennen."/>
                <Grid Margin="0,6,0,0" ColumnDefinitions="*,6,Auto,6,Auto">
                  <Button x:Name="CleanButton" Content="🧹  Opschonen" Classes="pill" Margin="0" IsEnabled="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                  <Button x:Name="UndoCleanButton" Grid.Column="2" Content="↩  origineel" Classes="pill" Margin="0" Padding="10,6" IsEnabled="False"
                          ToolTip.Tip="Terug naar de mesh zoals hij uit het bestand kwam"/>
                  <Button x:Name="SaveStlButton" Grid.Column="4" Content="💾  STL" Classes="pill" Margin="0" Padding="10,6" IsEnabled="False"
                          ToolTip.Tip="De mesh zoals je hem nu ziet (opgeschoond of niet) opslaan als STL, bijvoorbeeld voor MeshLab of je slicer"/>
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel>
              <TextBlock Text="🔍  WAT MOET IK HERKENNEN?" Classes="cardTitle"/>
              <WrapPanel>
                <ToggleButton x:Name="CylBox" Classes="chip" IsChecked="True" Content="🥫  Cilinders"/>
                <ToggleButton x:Name="SphBox" Classes="chip" IsChecked="True" Content="⚽  Bollen"/>
                <ToggleButton x:Name="TorBox" Classes="chip" IsChecked="True" Content="🍩  Tori"/>
                <ToggleButton x:Name="ConeBox" Classes="chip" IsChecked="True" Content="🍦  Kegels"
                              ToolTip.Tip="Schuine wanden rond een as (lossingshoek, verzinking, afschuining); vanaf 1° schuinte"/>
              </WrapPanel>
              <Border BorderBrush="{StaticResource Muted}" BorderThickness="0,1,0,0" Opacity="0.35" Margin="0,8,0,6"/>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Nieuwe groep na ✨" Classes="label" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <ToggleButton x:Name="KeepPlanesBox" Grid.Column="1" Classes="chip" IsChecked="True" Content="🔒  rest vasthouden"
                              ToolTip.Tip="Aan: maak of verwijder je een groep nadat alles herkend is, dan wordt alleen het stuk rond die groep opnieuw bekeken; de rest blijft precies zoals hij was (snel). Bij ✨ blijven de vlakke vlakken staan. Uit: steeds alles opnieuw."/>
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel>
              <TextBlock Text="🖌️  ZELF AANWIJZEN" Classes="cardTitle"/>
              <WrapPanel>
                <RadioButton x:Name="ModeView" GroupName="Mode" Classes="chip" IsChecked="True" Content="👆  bekijken"/>
                <RadioButton x:Name="ModeBrush" GroupName="Mode" Classes="chip" Content="🖌️  penseel"/>
                <RadioButton x:Name="ModeWand" GroupName="Mode" Classes="chip" Content="🪄  toverstaf"/>
              </WrapPanel>
              <StackPanel IsVisible="{Binding #ModeBrush.IsChecked}">
                <Grid><TextBlock Text="Penseel" Classes="label"/><TextBlock x:Name="BrushText" Classes="value"/></Grid>
                <Slider x:Name="BrushSlider" Minimum="0" Maximum="5" Value="0.8" ToolTip.Tip="Straal van het penseel in de eenheid van het bestand (0 = één driehoekje)"/>
              </StackPanel>
              <StackPanel IsVisible="{Binding #ModeWand.IsChecked}">
                <Grid><TextBlock Text="Toverstaf stopt bij een knik van" Classes="label"/><TextBlock x:Name="WandText" Classes="value"/></Grid>
                <Slider x:Name="WandSlider" Minimum="1" Maximum="45" Value="12" ToolTip.Tip="De toverstaf kruipt over randen tussen driehoekjes zolang de knik kleiner is dan deze hoek"/>
              </StackPanel>
              <ToggleButton x:Name="AutoDoubleBox" Classes="chip" IsChecked="False" HorizontalAlignment="Left" Margin="0,4,0,2" Content="🧠  dubbelklik automatisch"
                            ToolTip.Tip="Aan: dubbelklik kiest zelf: een plat vlak, of op een ronding de stroken rond dezelfde as. Uit: het schuifje hieronder bepaalt het."/>
              <StackPanel IsEnabled="{Binding !#AutoDoubleBox.IsChecked}">
                <Grid><TextBlock Text="Dubbelklik: helling mag afwijken" Classes="label"/><TextBlock x:Name="DoubleText" Classes="value"/></Grid>
                <Slider x:Name="DoubleSlider" Minimum="0" Maximum="90" Value="0" IsSnapToTickEnabled="True" TickFrequency="1"
                        ToolTip.Tip="Dubbelklik selecteert de aansluitende driehoekjes waarvan de helling hooguit zoveel graden afwijkt van het aangeklikte driehoekje. 0° = alleen het platte vlak; voor een ronding bijvoorbeeld 45° of 90°."/>
              </StackPanel>
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11.5"
                         Text="Dubbelklik = erbij selecteren · Ctrl = weghalen · Shift-klik = herkend vlak · Shift-dubbelklik = vlak openen (driehoekjes aanklikken) · Esc = wissen"/>
              <StackPanel x:Name="GroupList" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>

          <Border Classes="card" Padding="16,10">
            <StackPanel>
              <Grid>
                <ToggleButton x:Name="TuneToggle" Classes="fold" HorizontalAlignment="Left" ToolTip.Tip="Schuifjes tonen of verbergen" Content="🎚️  FIJNAFSTELLING"/>
                <Button x:Name="DefaultsButton" Content="↺ standaard" HorizontalAlignment="Right" VerticalAlignment="Center" Classes="pill" Padding="10,2" Margin="0" FontSize="11"/>
              </Grid>
              <StackPanel Margin="0,8,0,0" IsVisible="{Binding #TuneToggle.IsChecked}">
                <Grid><TextBlock Text="Vlakken samenvoegen tot" Classes="label"/><TextBlock x:Name="AngleText" Classes="value"/></Grid>
                <Slider x:Name="AngleSlider" Minimum="-3" Maximum="0" Value="-2" ToolTip.Tip="Maximale hoek tussen driehoeken die één plat vlak worden"/>
                <Grid><TextBlock Text="Hoe precies moet het passen?" Classes="label"/><TextBlock x:Name="FitText" Classes="value"/></Grid>
                <Slider x:Name="FitSlider" Minimum="-2" Maximum="1.5" Value="-1"
                        ToolTip.Tip="Hoekpunten moeten zó dicht op een cilinder/bol/torus liggen om die te herkennen. Ruimer = meer herkend, maar ook meer valse vormen."/>
                <Grid><TextBlock Text="Bijpakken binnen" Classes="label"/><TextBlock x:Name="JoinText" Classes="value"/></Grid>
                <Slider x:Name="JoinSlider" Minimum="0" Maximum="50" Value="10"
                        ToolTip.Tip="Driehoeken die zo dicht bij een herkend gebogen vlak liggen gaan erin op (hun hoekpunten worden er exact op gelegd)"/>
                <Grid><TextBlock Text="Rakend maken tot" Classes="label"/><TextBlock x:Name="TangentText" Classes="value"/></Grid>
                <Slider x:Name="TangentSlider" Minimum="0.5" Maximum="10" Value="3" ToolTip.Tip="Vlakken die binnen deze hoek langs een cilinder lopen worden exact rakend gemaakt"/>
                <Grid><TextBlock Text="Grootste straal" Classes="label"/><TextBlock x:Name="RadiusText" Classes="value"/></Grid>
                <Slider x:Name="RadiusSlider" Minimum="1" Maximum="4" Value="3" ToolTip.Tip="Bijna vlakke facetten passen op enorme stralen; grotere stralen worden niet geaccepteerd"/>
                <Grid><TextBlock Text="Geduld (rondes)" Classes="label"/><TextBlock x:Name="RoundsText" Classes="value"/></Grid>
                <Slider x:Name="RoundsSlider" Minimum="1" Maximum="300" Value="300" IsSnapToTickEnabled="True" TickFrequency="1"
                        ToolTip.Tip="Hoe vaak conflicten opgelost mogen worden (meer = trager, soms beter)"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <StackPanel Grid.Row="2" Margin="0,4,0,0">
        <Grid Margin="0,0,0,8" ColumnDefinitions="*,8,Auto">
          <Button x:Name="RecognizeButton" Content="✨  Herken vormen" Classes="pill primary" FontSize="15" Padding="14,11" Margin="0" IsEnabled="False"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  ToolTip.Tip="Zoekt alles: vlakken, cilinders, bollen, tori en kegels (kan bij grote modellen minuten duren)"/>
          <Button x:Name="PlanesButton" Grid.Column="2" Content="▭  Platte vlakken" Classes="pill" Padding="12,11" Margin="0" IsEnabled="{Binding #RecognizeButton.IsEnabled}"
                  ToolTip.Tip="Alleen platte stukken samenvoegen tot vlakken (snel). Jouw groepen blijven; de rest blijft driehoekjes tot je er zelf een groep van maakt. Daarna blijven platte stukken ook bij nieuwe groepen samengevoegd."/>
        </Grid>
        <Grid Margin="0,0,0,8" ColumnDefinitions="*,8,*">
          <Button x:Name="TuneButton" Content="🎛️  Autotune" Classes="pill" Margin="0" Padding="10,9" IsEnabled="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  ToolTip.Tip="Probeert een reeks instellingen naast elkaar en kiest die met de minste vlakken"/>
          <Button x:Name="SaveButton" Grid.Column="2" Content="💾  Opslaan" Classes="pill" Margin="0" Padding="10,9" IsEnabled="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  ToolTip.Tip="Opslaan als .rsdocx voor DesignSpark"/>
        </Grid>
        <!-- only when another program (PushPullMe) opened this window: the result handed over, no file in between -->
        <Button x:Name="TakeButton" Content="✅  Overnemen in PushPullMe" Classes="pill primary" Margin="0,0,0,8" Padding="10,9" IsVisible="False"
                IsEnabled="{Binding #SaveButton.IsEnabled}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                ToolTip.Tip="Het herkende model (of, zonder herkenning, de platte vlakken) gaat naar PushPullMe; dit venster sluit"/>
        <Border Classes="float" CornerRadius="14" Padding="14,8" Margin="0,0,0,4">
          <SelectableTextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Text="Nog niets herkend." MaxHeight="64"
                               ToolTip.Tip="Tekst kun je selecteren en kopiëren (Ctrl+C)"/>
        </Border>
      </StackPanel>
    </Grid>

    <!-- ============================== 3D view -->
    <Border Grid.Column="1" CornerRadius="22" Background="{StaticResource ViewGradient}" BoxShadow="0 4 24 0 #1F1E3A8A" ClipToBounds="True">
      <Grid>
        <local:MeshView x:Name="View" Margin="6"/>

        <!-- empty state -->
        <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
          <TextBlock Text="📦" FontSize="64" HorizontalAlignment="Center"/>
          <TextBlock Text="Sleep een STL of 3MF hierheen" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
          <TextBlock Text="rechtsklik-slepen = draaien · wiel = zoomen · klik = vlak bekijken of selecteren" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- legend + toggles (top right) -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0">
          <WrapPanel x:Name="Legend" HorizontalAlignment="Right" MaxWidth="560"/>
          <ToggleButton x:Name="EdgesBox" Classes="chip" IsChecked="True" Content="✏️  randen" HorizontalAlignment="Right"/>
        </StackPanel>

        <!-- view chips (bottom right) -->
        <WrapPanel x:Name="ViewChips" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,10">
          <Button Content="🔭  passend" Classes="pill" Padding="12,6" Margin="0,0,6,6" Tag="fit"/>
          <Button Content="🧊  iso" Classes="pill" Padding="12,6" Margin="0,0,6,6" Tag="iso"/>
          <Button Content="⬇️  boven" Classes="pill" Padding="12,6" Margin="0,0,6,6" Tag="top"/>
          <Button Content="👀  voor" Classes="pill" Padding="12,6" Margin="0,0,6,6" Tag="front"/>
          <Button Content="↔️  zij" Classes="pill" Padding="12,6" Margin="0,0,6,6" Tag="side"/>
        </WrapPanel>

        <!-- selection action bar (bottom centre) -->
        <Border x:Name="SelectionBar" Classes="float" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,70" IsVisible="False" CornerRadius="24" Padding="16,10,10,4">
          <StackPanel>
            <TextBlock x:Name="SelectionText" FontWeight="SemiBold" Margin="4,0,0,8"/>
            <WrapPanel>
              <WrapPanel x:Name="ShapeButtons">
                <Button Content="▭  vlak" Classes="pill" Padding="12,6" Tag="Plane"/>
                <Button Content="🥫  cilinder" Classes="pill" Padding="12,6" Tag="Cylinder"/>
                <Button Content="⚽  bol" Classes="pill" Padding="12,6" Tag="Sphere"/>
                <Button Content="🍩  torus" Classes="pill" Padding="12,6" Tag="Torus"/>
                <Button Content="🍦  kegel" Classes="pill" Padding="12,6" Tag="Cone"/>
                <Button Content="📐  plat" Classes="pill" Padding="12,6" Tag="ForcePlane"
                        ToolTip.Tip="Maak hier hoe dan ook één plat vlak van: het best passende vlak, en alle punten (ook op de rand) worden erop gezet. De buurvlakken lopen mee. Voor een vlak dat bedoeld plat is maar bulten heeft."/>
                <Button Content="✨  kies zelf" Classes="pill primary" Padding="12,6" Tag="Facet" ToolTip.Tip="De eenvoudigste vorm die past: vlak, cilinder, bol, torus of kegel"/>
              </WrapPanel>
              <WrapPanel x:Name="OpenFaceButtons" IsVisible="False">
                <Button Content="✂️  los" Classes="pill" Padding="12,6" Tag="Loose"
                        ToolTip.Tip="Koppel deze driehoekjes los van het vlak: ze blijven losse driehoekjes (en blijven geselecteerd, zodat je ze met ➕ bij een ander vlak kunt voegen)"/>
                <Button x:Name="AddToButton" Content="➕  bij vlak" Classes="pill primary" Padding="12,6" ToolTip.Tip="Voeg deze driehoekjes toe aan een ander herkend vlak: klik daarna op dat vlak"/>
              </WrapPanel>
              <Button x:Name="ClearSelectionButton" Content="✖" Classes="pill" Padding="12,6" ToolTip.Tip="Selectie wissen (Esc)"/>
            </WrapPanel>
            <StackPanel x:Name="MeasureRow" Orientation="Horizontal" Margin="4,0,0,6">
              <TextBlock Text="📏 meten:" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Button x:Name="ThreadButton" Content="🔩  schroefdraad" Classes="pill" Padding="12,4" Margin="0"
                      ToolTip.Tip="Meet de schroefdraad in de selectie: maat, binnen/buiten, links/rechts, diameters, spoed, flankhoek en de as. Het model verandert niet."/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- toast (top centre, below busy) -->
        <Border x:Name="Toast" Classes="float" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,90,0,0" IsVisible="False" Padding="18,10" MaxWidth="520" IsHitTestVisible="False">
          <StackPanel>
            <TextBlock x:Name="ToastTitle" FontWeight="Bold" FontSize="15"/>
            <TextBlock x:Name="ToastText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
          </StackPanel>
        </Border>

        <!-- busy (top) -->
        <Border x:Name="BusyPanel" Classes="float" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,16,0,0" IsVisible="False" Padding="18,10">
          <StackPanel>
            <TextBlock x:Name="BusyText" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="BusyDetail" FontSize="11.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            <ProgressBar IsIndeterminate="True" Height="5" Width="260" Margin="0,8,0,0" Foreground="{StaticResource Accent}" Background="{StaticResource AccentSoft}"/>
            <Button x:Name="StopButton" Content="⏹  Stop" Classes="pill" HorizontalAlignment="Center" Margin="0,8,0,0" Padding="14,4" IsVisible="False"
                    ToolTip.Tip="Stoppen; het vorige resultaat blijft staan"/>
          </StackPanel>
        </Border>

        <!-- picked face (bottom left) -->
        <Border x:Name="PickCard" Classes="float" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="18" IsVisible="False" Padding="16,12" MaxWidth="420">
          <StackPanel>
            <TextBlock x:Name="PickTitle" FontSize="16" FontWeight="Bold"/>
            <SelectableTextBlock x:Name="PickText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <Button x:Name="OpenFaceButton" Content="🔍  open: driehoekjes tonen" Classes="pill" Padding="12,4" Margin="0,8,0,0" HorizontalAlignment="Left"
                    ToolTip.Tip="Laat de driehoekjes van dit vlak zien, om er losse uit te halen (ook: Shift-dubbelklik op het vlak)"/>
          </StackPanel>
        </Border>

        <!-- measured thread (top right, below the legend) -->
        <Border x:Name="ThreadCard" Classes="float" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,200,16,0" IsVisible="False" Padding="16,10,10,12" MaxWidth="420">
          <StackPanel>
            <DockPanel>
              <Button x:Name="CloseThreadButton" Content="✖" DockPanel.Dock="Right" Classes="pill" Padding="10,4" Margin="0" ToolTip.Tip="Sluiten"/>
              <TextBlock x:Name="ThreadTitle" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
            <SelectableTextBlock x:Name="ThreadText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" ToolTip.Tip="Selecteren en kopiëren kan (Ctrl+C)"/>
            <Button x:Name="ReplaceThreadButton" Content="🔩  vervang door gladde kern + echte draad" Classes="pill primary" Padding="12,6" Margin="0,10,0,0" HorizontalAlignment="Left"
                    ToolTip.Tip="De draaddriehoekjes worden een gladde cilinder op de kerndiameter; de draad wordt een apart, exact lichaam (zoals een helix-sweep in DesignSpark). Bij opslaan komen beide mee: voeg ze in DesignSpark samen (Combine)."/>
          </StackPanel>
        </Border>

        <!-- opened face (top left): its triangles shown, to pick from -->
        <Border x:Name="FaceBar" Classes="float" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="18,16,0,0" IsVisible="False" Padding="16,10,10,10" MaxWidth="380">
          <StackPanel>
            <DockPanel>
              <Button x:Name="CloseFaceButton" Content="✖" DockPanel.Dock="Right" Classes="pill" Padding="10,4" Margin="0" ToolTip.Tip="Vlak sluiten (Esc)"/>
              <TextBlock x:Name="FaceTitle" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
            <TextBlock x:Name="FaceText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,8"
                       Text="Klik driehoekjes aan (nog eens klikken = eraf, penseel werkt ook). Kies dan ✂️ los, of ➕ bij vlak om ze bij een ander vlak te voegen."/>
            <WrapPanel>
              <Button x:Name="SelectOpenFaceButton" Content="☑️  hele vlak" Classes="pill" Padding="12,4" ToolTip.Tip="Alle driehoekjes van dit vlak selecteren"/>
              <Button x:Name="DeselectOpenFaceButton" Content="☐  niets" Classes="pill" Padding="12,4" Margin="0,0,0,8" ToolTip.Tip="Alle driehoekjes van dit vlak deselecteren"/>
            </WrapPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
