<Project Sdk="Microsoft.NET.Sdk">

  <!-- The converter's window for Windows, Linux and macOS (Avalonia, the mesh through OpenGL): the same as the WPF window
       (tools/StlConverter), which stays for the WPF PushPullMe. On its own an app; PushPullMe's Avalonia window opens
       ConverterWindow from it for a mesh. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- (the program as it is downloaded: StlConverter, on every system) -->
    <AssemblyName>StlConverter</AssemblyName>
    <RootNamespace>StlConverter.Desktop</RootNamespace>
    <ApplicationIcon>..\StlConverter\logo.ico</ApplicationIcon>
    <!-- (vertex data handed to OpenGL by pointer) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- recognising runs the bodies in parallel (as the WPF window) -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- the language, the texts and what is handed over: shared with the WPF window -->
    <Compile Include="..\StlConverter\Lang.cs" Link="Shared\Lang.cs" />
    <Compile Include="..\StlConverter\Texts.cs" Link="Shared\Texts.cs" />
    <Compile Include="..\StlConverter\ConverterResult.cs" Link="Shared\ConverterResult.cs" />
    <AvaloniaResource Include="..\StlConverter\logo.png" Link="Assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RsDocx.Core\RsDocx.Core.csproj" />
  </ItemGroup>

</Project>
