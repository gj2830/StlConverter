<Project Sdk="Microsoft.NET.Sdk">

  <!-- The converter for Windows, Linux and macOS: a window around the shared view (tools/StlConverter.View). On its own
       an app; PushPullMe opens ConverterWindow from it for a mesh. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>StlConverter</AssemblyName>
    <RootNamespace>StlConverter</RootNamespace>
    <!-- the logo (logo.png, made square) as the icon of the program -->
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <!-- the bodies of a mesh are recognised in parallel: with the workstation GC the threads mostly wait for each other
         (obj_1_BCons: 656 s against 387 s with the server GC) -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StlConverter.View\StlConverter.View.csproj" />
  </ItemGroup>

</Project>
