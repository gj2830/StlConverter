<Window x:Class="StlConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:HelixToolkit.Wpf;assembly=HelixToolkit.Wpf"
        xmlns:local="clr-namespace:StlConverter"
        Title="Mesh ➜ Solid" Icon="pack://application:,,,/StlConverter;component/logo.ico" Height="900" Width="1480" Background="{DynamicResource Page}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/StlConverter;component/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolVis"/>
            <local:NotConverter x:Key="Not"/>
            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                <Setter Property="FontSize" Value="12.5"/>
            </Style>
            <Style x:Key="Value" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================== controls: fit a 900 px window without scrolling (fine tuning folds away,
             the brush/wand sliders only show in their mode); the buttons stay at the bottom -->
        <Grid Margin="4,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <DockPanel>
                    <Button x:Name="LanguageButton" DockPanel.Dock="Right" Content="🌐  NL" Style="{StaticResource PillButton}" VerticalAlignment="Center"
                            Click="Language_Click" ToolTip="Taal / language: Nederlands · English"/>
                    <!-- the logo, rounded (its light background then reads as a tile, also in the dark theme) -->
                    <Border Width="42" Height="39" CornerRadius="9" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Border.Background>
                            <ImageBrush ImageSource="pack://application:,,,/StlConverter;component/logo.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border.Background>
                    </Border>
                    <TextBlock Text="Mesh ➜ Solid" FontSize="26" FontWeight="Black" Foreground="{StaticResource AccentGradient}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="Van driehoekjes naar échte vlakken, cilinders, bollen en donuts."
                           TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="📂  BESTAND" Style="{StaticResource CardTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button x:Name="OpenButton" Content="Open STL / 3MF…" Style="{StaticResource PillButton}" Click="Open_Click" HorizontalAlignment="Left" Margin="0"/>
                            <ComboBox x:Name="UnitBox" Grid.Column="1" SelectedIndex="0" Width="70" VerticalAlignment="Center" ToolTip="Eenheid in het bestand">
                                <ComboBoxItem Content="mm" Tag="0.001"/>
                                <ComboBoxItem Content="inch" Tag="0.0254"/>
                                <ComboBoxItem Content="cm" Tag="0.01"/>
                                <ComboBoxItem Content="m" Tag="1"/>
                            </ComboBox>
                        </Grid>
                        <TextBlock x:Name="FileText" Text="…of sleep een bestand op het venster." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16,10">
                    <StackPanel>
                        <Grid>
                            <ToggleButton x:Name="CleanToggle" Cursor="Hand" HorizontalAlignment="Left" ToolTip="Opschonen tonen of verbergen" Content="🧹  OPSCHONEN">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <StackPanel Orientation="Horizontal" Background="Transparent">
                                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource CardTitle}" Margin="0"/>
                                            <TextBlock x:Name="Arrow" Text="  ▸" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Text" Value="  ▾"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <TextBlock x:Name="CleanBadge" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource Muted}"/>
                        </Grid>
                        <StackPanel Margin="0,8,0,0" Visibility="{Binding IsChecked, ElementName=CleanToggle, Converter={StaticResource BoolVis}}">
                            <WrapPanel>
                                <ToggleButton x:Name="HoleBox" Style="{StaticResource Chip}" IsChecked="True" Content="🕳️  gaten dichten"
                                              ToolTip="Open randen dichtmaken; een plat gat wordt plat gevuld."/>
                                <ToggleButton x:Name="ManifoldBox" Style="{StaticResource Chip}" IsChecked="True" Content="🧩  non-manifold"
                                              ToolTip="Dubbele driehoekjes en driehoekjes op een rand die al twee buren heeft weghalen (het gat dat dat geeft wordt gedicht)."/>
                                <ToggleButton x:Name="PiecesBox" Style="{StaticResource Chip}" IsChecked="True" Content="✂️  snippers weg"
                                              ToolTip="Losse stukjes kleiner dan 1 % van het grootste stuk weghalen."/>
                            </WrapPanel>
                            <Grid><TextBlock Text="Vereenvoudigen tot" Style="{StaticResource Label}"/><TextBlock x:Name="SimplifyText" Style="{StaticResource Value}"/></Grid>
                            <Slider x:Name="SimplifySlider" Minimum="1" Maximum="100" Value="100" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="SimplifySlider_Changed"
                                    ToolTip="Minder driehoekjes (voor heel grote meshes). De hoekpunten blijven originele punten. Let op: te ver vereenvoudigen maakt rondingen moeilijker te herkennen."/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Button x:Name="CleanButton" Content="🧹  Opschonen" Style="{StaticResource PillButton}" Margin="0" IsEnabled="False" Click="Clean_Click"/>
                                <Button x:Name="UndoCleanButton" Grid.Column="2" Content="↩  origineel" Style="{StaticResource PillButton}" Margin="0" Padding="10,6" IsEnabled="False" Click="UndoClean_Click"
                                        ToolTip="Terug naar de mesh zoals hij uit het bestand kwam"/>
                                <Button x:Name="SaveStlButton" Grid.Column="4" Content="💾  STL" Style="{StaticResource PillButton}" Margin="0" Padding="10,6" IsEnabled="False" Click="SaveStl_Click"
                                        ToolTip="De mesh zoals je hem nu ziet (opgeschoond of niet) opslaan als STL, bijvoorbeeld voor MeshLab of je slicer"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="🔍  WAT MOET IK HERKENNEN?" Style="{StaticResource CardTitle}"/>
                        <WrapPanel>
                            <ToggleButton x:Name="CylBox" Style="{StaticResource Chip}" IsChecked="True" Content="🥫  Cilinders"/>
                            <ToggleButton x:Name="SphBox" Style="{StaticResource Chip}" IsChecked="True" Content="⚽  Bollen"/>
                            <ToggleButton x:Name="TorBox" Style="{StaticResource Chip}" IsChecked="True" Content="🍩  Tori"/>
                            <ToggleButton x:Name="ConeBox" Style="{StaticResource Chip}" IsChecked="True" Content="🍦  Kegels"
                                          ToolTip="Schuine wanden rond een as (lossingshoek, verzinking, afschuining); vanaf 1° schuinte"/>
                        </WrapPanel>
                        <Border BorderBrush="{StaticResource Muted}" BorderThickness="0,1,0,0" Opacity="0.35" Margin="0,8,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Nieuwe groep na ✨" Style="{StaticResource Label}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <ToggleButton x:Name="KeepPlanesBox" Grid.Column="1" Style="{StaticResource Chip}" IsChecked="True"
                                          Content="🔒  rest vasthouden"
                                          ToolTip="Aan: maak of verwijder je een groep nadat alles herkend is, dan wordt alleen het stuk rond die groep opnieuw bekeken; de rest blijft precies zoals hij was (snel). Bij ✨ blijven de vlakke vlakken staan. Uit: steeds alles opnieuw."/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="🖌️  ZELF AANWIJZEN" Style="{StaticResource CardTitle}"/>
                        <WrapPanel>
                            <RadioButton x:Name="ModeView" GroupName="Mode" Style="{StaticResource ModeChip}" IsChecked="True" Content="👆  bekijken"/>
                            <RadioButton x:Name="ModeBrush" GroupName="Mode" Style="{StaticResource ModeChip}" Content="🖌️  penseel"/>
                            <RadioButton x:Name="ModeWand" GroupName="Mode" Style="{StaticResource ModeChip}" Content="🪄  toverstaf"/>
                        </WrapPanel>
                        <StackPanel Visibility="{Binding IsChecked, ElementName=ModeBrush, Converter={StaticResource BoolVis}}">
                            <Grid><TextBlock Text="Penseel" Style="{StaticResource Label}"/><TextBlock x:Name="BrushText" Style="{StaticResource Value}"/></Grid>
                            <Slider x:Name="BrushSlider" Minimum="0" Maximum="5" Value="0.8" ValueChanged="Slider_Changed"
                                    ToolTip="Straal van het penseel in de eenheid van het bestand (0 = één driehoekje)"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsChecked, ElementName=ModeWand, Converter={StaticResource BoolVis}}">
                            <Grid><TextBlock Text="Toverstaf stopt bij een knik van" Style="{StaticResource Label}"/><TextBlock x:Name="WandText" Style="{StaticResource Value}"/></Grid>
                            <Slider x:Name="WandSlider" Minimum="1" Maximum="45" Value="12" ValueChanged="Slider_Changed"
                                    ToolTip="De toverstaf kruipt over randen tussen driehoekjes zolang de knik kleiner is dan deze hoek"/>
                        </StackPanel>
                        <ToggleButton x:Name="AutoDoubleBox" Style="{StaticResource Chip}" IsChecked="False" HorizontalAlignment="Left" Margin="0,4,0,2"
                                      Content="🧠  dubbelklik automatisch"
                                      ToolTip="Aan: dubbelklik kiest zelf: een plat vlak, of op een ronding de stroken rond dezelfde as. Uit: het schuifje hieronder bepaalt het."/>
                        <StackPanel IsEnabled="{Binding IsChecked, ElementName=AutoDoubleBox, Converter={StaticResource Not}}">
                        <Grid><TextBlock Text="Dubbelklik: helling mag afwijken" Style="{StaticResource Label}"/><TextBlock x:Name="DoubleText" Style="{StaticResource Value}"/></Grid>
                        <Slider x:Name="DoubleSlider" Minimum="0" Maximum="90" Value="0" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Slider_Changed"
                                ToolTip="Dubbelklik selecteert de aansluitende driehoekjes waarvan de helling hooguit zoveel graden afwijkt van het aangeklikte driehoekje. 0° = alleen het platte vlak; voor een ronding bijvoorbeeld 45° of 90°."/>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11.5"
                                   Text="Dubbelklik = erbij selecteren · Ctrl = weghalen · Shift-klik = herkend vlak · Shift-dubbelklik = vlak openen (driehoekjes aanklikken) · Esc = wissen"/>
                        <StackPanel x:Name="GroupList" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16,10">
                    <StackPanel>
                        <Grid>
                            <ToggleButton x:Name="TuneToggle" Cursor="Hand" HorizontalAlignment="Left" ToolTip="Schuifjes tonen of verbergen" Content="🎚️  FIJNAFSTELLING">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <StackPanel Orientation="Horizontal" Background="Transparent">
                                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource CardTitle}" Margin="0"/>
                                            <TextBlock x:Name="Arrow" Text="  ▸" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Text" Value="  ▾"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Button Content="↺ standaard" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource PillButton}"
                                    Padding="10,2" Margin="0" FontSize="11" Click="Defaults_Click"/>
                        </Grid>
                        <StackPanel Margin="0,8,0,0" Visibility="{Binding IsChecked, ElementName=TuneToggle, Converter={StaticResource BoolVis}}">
                            <Grid><TextBlock Text="Vlakken samenvoegen tot" Style="{StaticResource Label}"/><TextBlock x:Name="AngleText" Style="{StaticResource Value}"/></Grid>
                            <Slider x:Name="AngleSlider" Minimum="-3" Maximum="0" Value="-2" ValueChanged="Slider_Changed"
                                    ToolTip="Maximale hoek tussen driehoeken die één plat vlak worden"/>

                            <Grid><TextBlock Text="Hoe precies moet het passen?" Style="{StaticResource Label}"/><TextBlock x:Name="FitText" Style="{StaticResource Value}"/></Grid>
                            <Slider x:Name="FitSlider" Minimum="-2" Maximum="1.5" Value="-1" ValueChanged="Slider_Changed"
                                    ToolTip="Hoekpunten moeten zó dicht op een cilinder/bol/torus liggen om die te herkennen. Ruimer = meer herkend, maar ook meer valse vormen."/>

                            <Grid><TextBlock Text="Bijpakken binnen" Style="{StaticResource Label}"/><TextBlock x:Name="JoinText" Style="{StaticResource Value}"/></Grid>
                            <Slider x:Name="JoinSlider" Minimum="0" Maximum="50" Value="10" ValueChanged="Slider_Changed"
                                    ToolTip="Driehoeken die zo dicht bij een herkend gebogen vlak liggen gaan erin op (hun hoekpunten worden er exact op gelegd)"/>

                            <Grid><TextBlock Text="Rakend maken tot" Style="{StaticResource Label}"/><TextBlock x:Name="TangentText" Style="{StaticResource Value}"/></Grid>
                            <Slider x:Name="TangentSlider" Minimum="0.5" Maximum="10" Value="3" ValueChanged="Slider_Changed"
                                    ToolTip="Vlakken die binnen deze hoek langs een cilinder lopen worden exact rakend gemaakt"/>

                            <Grid><TextBlock Text="Grootste straal" Style="{StaticResource Label}"/><TextBlock x:Name="RadiusText" Style="{StaticResource Value}"/></Grid>
                            <Slider x:Name="RadiusSlider" Minimum="1" Maximum="4" Value="3" ValueChanged="Slider_Changed"
                                    ToolTip="Bijna vlakke facetten passen op enorme stralen; grotere stralen worden niet geaccepteerd"/>

                            <Grid><TextBlock Text="Geduld (rondes)" Style="{StaticResource Label}"/><TextBlock x:Name="RoundsText" Style="{StaticResource Value}"/></Grid>
                            <Slider x:Name="RoundsSlider" Minimum="1" Maximum="300" Value="300" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Slider_Changed"
                                    ToolTip="Hoe vaak conflicten opgelost mogen worden (meer = trager, soms beter)"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="0,4,0,0">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button x:Name="RecognizeButton" Content="✨  Herken vormen" Style="{StaticResource PrimaryButton}" FontSize="15"
                            Padding="14,11" Margin="0" Click="Recognize_Click" IsEnabled="False"
                            ToolTip="Zoekt alles: vlakken, cilinders, bollen, tori en kegels (kan bij grote modellen minuten duren)"/>
                    <Button x:Name="PlanesButton" Grid.Column="2" Content="▭  Platte vlakken" Style="{StaticResource PillButton}" Padding="12,11" Margin="0"
                            Click="Planes_Click" IsEnabled="{Binding IsEnabled, ElementName=RecognizeButton}"
                            ToolTip="Alleen platte stukken samenvoegen tot vlakken (snel). Jouw groepen blijven; de rest blijft driehoekjes tot je er zelf een groep van maakt. Daarna blijven platte stukken ook bij nieuwe groepen samengevoegd."/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button x:Name="TuneButton" Content="🎛️  Autotune" Style="{StaticResource PillButton}" Margin="0"
                            Padding="10,9" Click="Autotune_Click" IsEnabled="False"
                            ToolTip="Probeert een reeks instellingen naast elkaar en kiest die met de minste vlakken"/>
                    <Button x:Name="SaveButton" Grid.Column="2" Content="💾  Opslaan" Style="{StaticResource PillButton}" Margin="0"
                            Padding="10,9" Click="Save_Click" IsEnabled="False" ToolTip="Opslaan als .rsdocx voor DesignSpark"/>
                </Grid>
                <!-- only when another program (PushPullMe) opened this window: the result handed over, no file in between -->
                <Button x:Name="TakeButton" Content="✅  Overnemen in PushPullMe" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8"
                        Padding="10,9" Click="Take_Click" Visibility="Collapsed" IsEnabled="{Binding IsEnabled, ElementName=SaveButton}"
                        ToolTip="Het herkende model (of, zonder herkenning, de platte vlakken) gaat naar PushPullMe; dit venster sluit"/>
                <Border Background="White" CornerRadius="14" Padding="14,8" Effect="{StaticResource Shadow}" Margin="0,0,0,4">
                    <TextBox x:Name="StatusText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Text="Nog niets herkend." MaxHeight="64" VerticalScrollBarVisibility="Auto" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" Cursor="IBeam" ToolTip="Tekst kun je selecteren en kopiëren (Ctrl+C)"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ============================== 3D view -->
        <Border Grid.Column="1" CornerRadius="22" Background="{StaticResource ViewGradient}" Effect="{StaticResource Shadow}">
            <Grid>
                <h:HelixViewport3D x:Name="View" ZoomExtentsWhenLoaded="True" Margin="6"
                                   MouseLeftButtonUp="View_MouseLeftButtonUp" PreviewMouseLeftButtonDown="View_MouseLeftButtonDown" MouseMove="View_MouseMove" Background="Transparent" ShowViewCube="False" ShowCoordinateSystem="False"
                                   IsHeadLightEnabled="True">
                    <ModelVisual3D>
                        <ModelVisual3D.Content>
                            <AmbientLight Color="#707078"/>
                        </ModelVisual3D.Content>
                    </ModelVisual3D>
                    <ModelVisual3D x:Name="ModelHost"/>
                    <ModelVisual3D x:Name="HighlightHost"/>
                    <ModelVisual3D x:Name="OverlayHost"/>
                    <ModelVisual3D x:Name="CoilHost"/>
                </h:HelixViewport3D>

                <!-- empty state -->
                <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock Text="📦" FontSize="64" HorizontalAlignment="Center"/>
                    <TextBlock Text="Sleep een STL of 3MF hierheen" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="rechtsklik-slepen = draaien · wiel = zoomen · klik = vlak bekijken of selecteren" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- legend + toggles (top right) -->
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0">
                    <WrapPanel x:Name="Legend" HorizontalAlignment="Right" MaxWidth="560"/>
                    <ToggleButton x:Name="EdgesBox" Style="{StaticResource Chip}" IsChecked="True" Content="✏️  randen" HorizontalAlignment="Right" Click="Edges_Click"/>
                </StackPanel>

                <!-- view chips (bottom right) -->
                <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,10">
                    <Button Content="🔭  passend" Style="{StaticResource PillButton}" Padding="12,6" Margin="0,0,6,6" Tag="fit" Click="ViewButton_Click"/>
                    <Button Content="🧊  iso" Style="{StaticResource PillButton}" Padding="12,6" Margin="0,0,6,6" Tag="iso" Click="ViewButton_Click"/>
                    <Button Content="⬇️  boven" Style="{StaticResource PillButton}" Padding="12,6" Margin="0,0,6,6" Tag="top" Click="ViewButton_Click"/>
                    <Button Content="👀  voor" Style="{StaticResource PillButton}" Padding="12,6" Margin="0,0,6,6" Tag="front" Click="ViewButton_Click"/>
                    <Button Content="↔️  zij" Style="{StaticResource PillButton}" Padding="12,6" Margin="0,0,6,6" Tag="side" Click="ViewButton_Click"/>
                </WrapPanel>

                <!-- selection action bar (bottom centre) -->
                <Border x:Name="SelectionBar" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,70" Visibility="Collapsed"
                        Background="White" CornerRadius="24" Padding="16,10,10,4" Effect="{StaticResource Shadow}">
                    <StackPanel>
                        <TextBlock x:Name="SelectionText" FontWeight="SemiBold" Margin="4,0,0,8"/>
                        <WrapPanel>
                            <!-- shape buttons: for a selection on the model -->
                            <WrapPanel x:Name="ShapeButtons">
                                <Button Content="▭  vlak" Style="{StaticResource PillButton}" Padding="12,6" Tag="Plane" Click="MakeGroup_Click"/>
                                <Button Content="🥫  cilinder" Style="{StaticResource PillButton}" Padding="12,6" Tag="Cylinder" Click="MakeGroup_Click"/>
                                <Button Content="⚽  bol" Style="{StaticResource PillButton}" Padding="12,6" Tag="Sphere" Click="MakeGroup_Click"/>
                                <Button Content="🍩  torus" Style="{StaticResource PillButton}" Padding="12,6" Tag="Torus" Click="MakeGroup_Click"/>
                                <Button Content="🍦  kegel" Style="{StaticResource PillButton}" Padding="12,6" Tag="Cone" Click="MakeGroup_Click"/>
                                <Button Content="📐  plat" Style="{StaticResource PillButton}" Padding="12,6" Tag="ForcePlane" Click="MakeGroup_Click"
                                        ToolTip="Maak hier hoe dan ook één plat vlak van: het best passende vlak, en alle punten (ook op de rand) worden erop gezet. De buurvlakken lopen mee. Voor een vlak dat bedoeld plat is maar bulten heeft."/>
                                <Button Content="✨  kies zelf" Style="{StaticResource PrimaryButton}" Padding="12,6" Tag="Facet" Click="MakeGroup_Click"
                                        ToolTip="De eenvoudigste vorm die past: vlak, cilinder, bol, torus of kegel"/>
                            </WrapPanel>
                            <!-- for triangles picked in an opened face -->
                            <WrapPanel x:Name="OpenFaceButtons" Visibility="Collapsed">
                                <Button Content="✂️  los" Style="{StaticResource PillButton}" Padding="12,6" Tag="Loose" Click="MakeGroup_Click"
                                        ToolTip="Koppel deze driehoekjes los van het vlak: ze blijven losse driehoekjes (en blijven geselecteerd, zodat je ze met ➕ bij een ander vlak kunt voegen)"/>
                                <Button Content="➕  bij vlak" Style="{StaticResource PrimaryButton}" Padding="12,6" Click="AddTo_Click"
                                        ToolTip="Voeg deze driehoekjes toe aan een ander herkend vlak: klik daarna op dat vlak"/>
                            </WrapPanel>
                            <Button Content="✖" Style="{StaticResource PillButton}" Padding="12,6" Click="ClearSelection_Click" ToolTip="Selectie wissen (Esc)"/>
                        </WrapPanel>
                        <!-- measuring: does not change the model -->
                        <StackPanel x:Name="MeasureRow" Orientation="Horizontal" Margin="4,0,0,6">
                            <TextBlock Text="📏 meten:" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="🔩  schroefdraad" Style="{StaticResource PillButton}" Padding="12,4" Margin="0" Click="Thread_Click"
                                    ToolTip="Meet de schroefdraad in de selectie: maat, binnen/buiten, links/rechts, diameters, spoed, flankhoek en de as. Het model verandert niet."/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- toast (top centre, below busy) -->
                <Border x:Name="Toast" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,90,0,0" Visibility="Collapsed"
                        Background="White" CornerRadius="16" Padding="18,10" Effect="{StaticResource Shadow}" MaxWidth="520" IsHitTestVisible="False">
                    <StackPanel>
                        <TextBlock x:Name="ToastTitle" FontWeight="Bold" FontSize="15"/>
                        <TextBlock x:Name="ToastText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- busy (top) -->
                <Border x:Name="BusyPanel" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,16,0,0" Visibility="Collapsed"
                        Background="White" CornerRadius="16" Padding="18,10" Effect="{StaticResource Shadow}">
                    <StackPanel>
                        <TextBlock x:Name="BusyText" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="BusyDetail" FontSize="11.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Height="5" Width="260" Margin="0,8,0,0" Foreground="{StaticResource Accent}" Background="{StaticResource AccentSoft}" BorderThickness="0"/>
                        <Button x:Name="StopButton" Content="⏹  Stop" Style="{StaticResource PillButton}" HorizontalAlignment="Center" Margin="0,8,0,0" Padding="14,4"
                                Visibility="Collapsed" Click="Stop_Click" ToolTip="Stoppen; het vorige resultaat blijft staan"/>
                    </StackPanel>
                </Border>

                <!-- picked face (bottom left) -->
                <Border x:Name="PickCard" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="18" Visibility="Collapsed"
                        Background="White" CornerRadius="16" Padding="16,12" Effect="{StaticResource Shadow}" MaxWidth="420">
                    <StackPanel>
                        <TextBlock x:Name="PickTitle" FontSize="16" FontWeight="Bold"/>
                        <TextBox x:Name="PickText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" Cursor="IBeam"/>
                        <Button x:Name="OpenFaceButton" Content="🔍  open: driehoekjes tonen" Style="{StaticResource PillButton}" Padding="12,4" Margin="0,8,0,0"
                                HorizontalAlignment="Left" Click="OpenPickedFace_Click"
                                ToolTip="Laat de driehoekjes van dit vlak zien, om er losse uit te halen (ook: Shift-dubbelklik op het vlak)"/>
                    </StackPanel>
                </Border>

                <!-- measured thread (top right, below the legend) -->
                <Border x:Name="ThreadCard" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,200,16,0" Visibility="Collapsed"
                        Background="White" CornerRadius="16" Padding="16,10,10,12" Effect="{StaticResource Shadow}" MaxWidth="420">
                    <StackPanel>
                        <DockPanel>
                            <Button Content="✖" DockPanel.Dock="Right" Style="{StaticResource PillButton}" Padding="10,4" Click="CloseThread_Click" ToolTip="Sluiten"/>
                            <TextBlock x:Name="ThreadTitle" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                        <TextBox x:Name="ThreadText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                 IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" Cursor="IBeam" ToolTip="Selecteren en kopiëren kan (Ctrl+C)"/>
                        <Button x:Name="ReplaceThreadButton" Content="🔩  vervang door gladde kern + echte draad" Style="{StaticResource PrimaryButton}"
                                Padding="12,6" Margin="0,10,0,0" HorizontalAlignment="Left" Click="ReplaceThread_Click"
                                ToolTip="De draaddriehoekjes worden een gladde cilinder op de kerndiameter; de draad wordt een apart, exact lichaam (zoals een helix-sweep in DesignSpark). Bij opslaan komen beide mee: voeg ze in DesignSpark samen (Combine)."/>
                    </StackPanel>
                </Border>

                <!-- opened face (top left): its triangles shown, to pick from -->
                <Border x:Name="FaceBar" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="18,16,0,0" Visibility="Collapsed"
                        Background="White" CornerRadius="16" Padding="16,10,10,10" Effect="{StaticResource Shadow}" MaxWidth="380">
                    <StackPanel>
                        <DockPanel>
                            <Button Content="✖" DockPanel.Dock="Right" Style="{StaticResource PillButton}" Padding="10,4" Click="CloseFace_Click" ToolTip="Vlak sluiten (Esc)"/>
                            <TextBlock x:Name="FaceTitle" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                        <TextBlock x:Name="FaceText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,8"
                                   Text="Klik driehoekjes aan (nog eens klikken = eraf, penseel werkt ook). Kies dan ✂️ los, of ➕ bij vlak om ze bij een ander vlak te voegen."/>
                        <WrapPanel>
                            <Button Content="☑️  hele vlak" Style="{StaticResource PillButton}" Padding="12,4" Click="SelectOpenFace_Click" ToolTip="Alle driehoekjes van dit vlak selecteren"/>
                            <Button Content="☐  niets" Style="{StaticResource PillButton}" Padding="12,4" Margin="0,0,0,8" Click="DeselectOpenFace_Click" ToolTip="Alle driehoekjes van dit vlak deselecteren"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
