<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!-- The converter in a browser (WebAssembly): the shared view (StlConverter.View) in a web page, the mesh through
       WebGL 2. Files come in through the page's file picker and go out to where the user chooses (BrowserKit). Needs
       the wasm-tools workload; published, it is served from the publish folder's wwwroot (any static web server). -->
  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>StlConverter</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StlConverter.View\StlConverter.View.csproj" />
    <ProjectReference Include="..\..\src\BrowserKit\BrowserKit.csproj" />
  </ItemGroup>

</Project>
